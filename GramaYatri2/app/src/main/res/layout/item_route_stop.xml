<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_light_blue"
    android:paddingStart="24dp">

    <!-- Vertical Line -->
    <View
        android:id="@+id/viewLineTop"
        android:layout_width="4dp"
        android:layout_height="30dp"
        android:background="@color/primary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="@id/ivStopDot"
        app:layout_constraintEnd_toEndOf="@id/ivStopDot"/>

    <View
        android:id="@+id/viewLineBottom"
        android:layout_width="4dp"
        android:layout_height="30dp"
        android:background="@color/primary"
        app:layout_constraintTop_toBottomOf="@id/ivStopDot"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/ivStopDot"
        app:layout_constraintEnd_toEndOf="@id/ivStopDot"/>

    <!-- Stop Dot -->
    <ImageView
        android:id="@+id/ivStopDot"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@android:drawable/presence_invisible"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/tvStopName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Stop Name"
        android:textSize="16sp"
        android:textColor="@color/text_main"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toTopOf="@id/ivStopDot"
        app:layout_constraintBottom_toBottomOf="@id/ivStopDot"
        app:layout_constraintStart_toEndOf="@id/ivStopDot"
        app:layout_constraintEnd_toStartOf="@id/tvStopTime"/>

    <TextView
        android:id="@+id/tvStopTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00 AM"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:layout_marginEnd="24dp"
        app:layout_constraintTop_toTopOf="@id/tvStopName"
        app:layout_constraintBottom_toBottomOf="@id/tvStopName"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>